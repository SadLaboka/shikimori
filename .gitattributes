# Preserve byte hashes of pinned upstream snapshots across Windows checkouts.
vendor/edesign/*.css text eol=lf
# Keep upstream trailing spaces in these byte-verified snapshots; local code stays checked.
vendor/edesign/main_code_1.css whitespace=-blank-at-eol
vendor/edesign/main_code_4mob.css whitespace=-blank-at-eol
css/base/*.css text eol=lf
# The owned main1 copy retains the same upstream trailing spaces as its vendor snapshot.
css/base/main_code_1.css whitespace=-blank-at-eol
# Preserve the byte-identical main4 snapshot as well.
css/base/main_code_4mob.css whitespace=-blank-at-eol
# Source components and deployment output must concatenate identically on Windows.
css/components/*.css text eol=lf
styles_optimized.css text eol=lf
# Theme sources and generated output must also retain their verified byte hashes.
css/themes/*/*.css text eol=lf
# Generated themes preserve trailing spaces inherited from the shared legacy CSS.
css/themes/*/styles.css whitespace=-blank-at-eol
